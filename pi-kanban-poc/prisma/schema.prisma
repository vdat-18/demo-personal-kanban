generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectDomain {
  SOFTWARE_ENGINEERING
  MARKETING
  SALES
  LOGISTICS
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id              String           @id @default(uuid())
  name            String
  description     String?
  domain          ProjectDomain    @default(SOFTWARE_ENGINEERING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tasks           Task[]
  planningThreads PlanningThread[]

  @@index([createdAt()])
}

model Task {
  id            String         @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(MEDIUM)
  projectId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project?       @relation(fields: [projectId], references: [id])
  conversations Conversation[]
  subtasks      Subtask[]

  @@index([status()])
  @@index([priority()])
  @@index([createdAt()])
  @@index([projectId()])
}

model Subtask {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  completed   Boolean  @default(false)
  output      String?  @db.Text
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
}

model Conversation {
  id         String   @id @default(uuid())
  taskId     String?
  messages   Json
  result     Json?
  tokenUsage Json
  createdAt  DateTime @default(now())
  task       Task?    @relation(fields: [taskId], references: [id])

  @@index([taskId()])
  @@index([createdAt()])
}

enum PlanningMessageRole {
  user
  assistant
  system
}

enum PlanningPhase {
  discovery
  blueprint
  task_mapping
}

model PlanningThread {
  id             String            @id @default(uuid())
  projectId      String
  title          String            @default("New Thread")
  phase          PlanningPhase     @default(discovery)
  visionDocument String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages       PlanningMessage[]

  @@index([projectId()])
  @@index([updatedAt()])
}

model PlanningMessage {
  id              String              @id @default(uuid())
  threadId        String
  role            PlanningMessageRole
  content         String
  tokenUsage      Json?
  createdAt       DateTime            @default(now())
  thread          PlanningThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mutationActions MutationAction[]

  @@index([threadId()])
  @@index([createdAt()])
}

enum MutationActionType {
  approved
  dismissed
}

model MutationAction {
  id            String             @id @default(uuid())
  messageId     String
  mutationIndex Int
  action        MutationActionType
  createdAt     DateTime           @default(now())
  message       PlanningMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, mutationIndex])
  @@index([messageId()])
}
